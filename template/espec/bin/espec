#!/usr/bin/env bash
# espec: helper CLI for Enterprise Spec Driven Development (spec-driven development) projects.
# Dependency free: bash 3.2+, the POSIX tools grep, sed, awk, find, cp, mkdir, date, and sha256sum or
# shasum for the delta base stamps.
set -euo pipefail

MARKER='<!-- espec:feature-definition v1 -->'
CHECKS=0
FAILS=0

resolve_bin_dir() {
  local src="$0" dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd "$(dirname "$src")" && pwd
}
BIN_DIR=$(resolve_bin_dir)
# This script lives at <root>/espec/bin/espec. In the toolkit checkout <root> is template/,
# which init and update copy from. In a project it is the project itself.
TEMPLATE_DIR=$(dirname "$(dirname "$BIN_DIR")")
TOOLKIT_ROOT=$(dirname "$TEMPLATE_DIR")

usage() {
  cat <<'EOF'
espec: spec-driven development helper (Enterprise Spec Driven Development)

Usage: espec <command> [arguments]

  init [dir]                 Copy the espec template into a repository (never overwrites existing files)
  update [dir]               Refresh the managed files: prompts, instructions, workflow, AGENTS.md, templates, espec/bin,
                             espec/LICENSE.md and espec/.toolkit-version
                             (init and update run from the toolkit checkout; the other commands work from espec/bin in a project)
  new <name> [options] [dir] Start a change under espec/changes/<name>
                             (options: --ticket KEY, --title "Title", --kind feature|bug)
  list [dir]                 Show active changes with status, ticket and task progress
  validate [name] [dir]      Check one change, or every active change, plus the main specs
  stamp <name> [--rebase] [dir]
                             Record in each MODIFIED and REMOVED requirement of a change the version of the main
                             spec it was written against. --rebase re-records requirements whose main spec changed.
  version [dir]              Show the toolkit version a project was set up or last updated with
  help                       Show this help

[dir] defaults to the current directory. An espec/ folder marks an initialised project.
EOF
}

die() { echo "error: $*" >&2; exit 1; }
need_template() {
  [ "$(basename "$TEMPLATE_DIR")" = template ] && [ -f "$TEMPLATE_DIR/espec/AGENTS.md" ] ||
    die "init and update run from the toolkit checkout: <toolkit>/bin/espec $1 <dir>"
}
make_executable() { case "$1" in espec/bin/*) chmod +x "$2" ;; esac; }
need_project() { [ -d "$1/espec" ] || die "$1 is not a espec project (no espec/ folder). Run: espec init $1"; }

# yaml_value FILE KEY: top-level scalar value without trailing comment, empty when absent.
yaml_value() {
  [ -f "$1" ] || return 0
  awk -v k="$2" 'index($0, k ":") == 1 {
    v = substr($0, length(k) + 2); sub(/[ \t]+#.*$/, "", v); gsub(/^[ \t]+|[ \t\r]+$/, "", v); print v; exit }' "$1"
}

# task_counts FILE: prints "done total" for checkbox lines in a tasks.md.
task_counts() {
  awk '/^[ \t]*- \[.\]/ { t++ } /^[ \t]*- \[[xX]\]/ { d++ } END { printf "%d %d\n", d, t }' "$1"
}

# ---------------------------------------------------------------- init / update

cmd_init() {
  local dir="${1:-.}" src rel
  need_template init
  mkdir -p "$dir"
  echo "Initialising espec in $dir"
  find "$TEMPLATE_DIR" -type f | sort | while IFS= read -r src; do
    rel="${src#$TEMPLATE_DIR/}"
    if [ -e "$dir/$rel" ]; then
      echo "  skipped (exists)  $rel"
    else
      mkdir -p "$(dirname "$dir/$rel")"
      cp "$src" "$dir/$rel"; make_executable "$rel" "$dir/$rel"
      echo "  created           $rel"
    fi
  done
  record_toolkit "$dir"
  cat <<EOF

Next steps:
  1. Edit espec/project.md and espec/config.yaml: product, stack, conventions, ticket system.
  2. Commit the new files. The workflow in .github/workflows/espec-validate.yml runs
     espec/bin/espec validate on pull requests that touch espec/.
  3. Restart your IDE so GitHub Copilot picks up the prompt files in .github/prompts.
  4. Name the tech proposal approvers in CODEOWNERS and require code owner review on the default
     branch: docs/guides/setup-engineering.md, step 5, in the toolkit.
  5. Point product managers to the product-ai pack (Rovo and M365 Copilot) in $TOOLKIT_ROOT/product-ai
EOF
}

# record_toolkit DIR: copy the toolkit licence and version into DIR/espec. The licence travels with
# every copy of the toolkit's files; the version tells the team which prompts they are running.
record_toolkit() {
  local dir="$1" src dest rel
  for rel in LICENSE.md:espec/LICENSE.md VERSION:espec/.toolkit-version; do
    src="$TOOLKIT_ROOT/${rel%%:*}"; dest="$dir/${rel#*:}"
    if [ ! -e "$dest" ]; then cp "$src" "$dest"; echo "  created    ${rel#*:}"
    elif cmp -s "$src" "$dest"; then echo "  unchanged  ${rel#*:}"
    else cp "$src" "$dest"; echo "  updated    ${rel#*:}"; fi
  done
}

# Files that update may overwrite, relative to the project root.
managed_files() {
  (
    cd "$TEMPLATE_DIR"
    find .github/prompts -name 'espec-*.prompt.md'
    find .github/instructions -name 'espec.instructions.md'
    find .github/workflows -name 'espec-*.yml'
    echo espec/AGENTS.md
    find espec/templates -type f
    find espec/bin -type f
  ) | sort
}

cmd_update() {
  local dir="${1:-.}" rel
  need_template update
  need_project "$dir"
  local from="unknown"
  [ ! -f "$dir/espec/.toolkit-version" ] || from="v$(tr -d '\r\n' < "$dir/espec/.toolkit-version")"
  echo "Updating managed espec files in $dir ($from -> v$(tr -d '\r\n' < "$TOOLKIT_ROOT/VERSION"))"
  managed_files | while IFS= read -r rel; do
    if [ ! -e "$dir/$rel" ]; then
      mkdir -p "$(dirname "$dir/$rel")"
      cp "$TEMPLATE_DIR/$rel" "$dir/$rel"; make_executable "$rel" "$dir/$rel"
      echo "  created    $rel"
    elif cmp -s "$TEMPLATE_DIR/$rel" "$dir/$rel"; then
      echo "  unchanged  $rel"
    else
      cp "$TEMPLATE_DIR/$rel" "$dir/$rel"; make_executable "$rel" "$dir/$rel"
      echo "  updated    $rel"
    fi
  done
  record_toolkit "$dir"
  echo "Done. copilot-instructions.md, CODEOWNERS, project.md, config.yaml, specs/ and changes/ were not touched."
}

cmd_version() {
  local dir="${1:-.}"
  if [ -f "$dir/espec/.toolkit-version" ]; then
    echo "espec v$(tr -d '\r\n' < "$dir/espec/.toolkit-version") ($dir)"
  elif [ "$(basename "$TEMPLATE_DIR")" = template ] && [ -f "$TOOLKIT_ROOT/VERSION" ]; then
    echo "espec v$(tr -d '\r\n' < "$TOOLKIT_ROOT/VERSION") (toolkit at $TOOLKIT_ROOT)"
  else
    echo "espec: version not recorded in $dir. Run espec update from the toolkit to record it."
  fi
}

# ---------------------------------------------------------------- new / list

cmd_new() {
  local name="" ticket="" title="" kind="" dir="." today change tpl line f
  while [ $# -gt 0 ]; do
    case "$1" in
      --ticket) [ $# -ge 2 ] || die "--ticket needs a value"; ticket="$2"; shift 2 ;;
      --title)  [ $# -ge 2 ] || die "--title needs a value"; title="$2"; shift 2 ;;
      --kind)   [ $# -ge 2 ] || die "--kind needs a value"; kind="$2"; shift 2 ;;
      --kind=*) kind="${1#--kind=}"; shift ;;
      --ticket=*) ticket="${1#--ticket=}"; shift ;;
      --title=*)  title="${1#--title=}"; shift ;;
      -*) die "unknown option: $1" ;;
      *) if [ -z "$name" ]; then name="$1"; else dir="$1"; fi; shift ;;
    esac
  done
  [ -n "$name" ] || die 'usage: espec new <change-name> [--ticket KEY] [--title "Title"] [--kind feature|bug] [dir]'
  case "$kind" in ""|feature|bug) ;; *) die "--kind must be feature or bug: $kind" ;; esac
  echo "$name" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$' \
    || die "change name must be kebab-case (lowercase letters, digits, dashes): $name"
  need_project "$dir"
  tpl="$dir/espec/templates"
  for f in feature.md tech-proposal.md tasks.md espec.yaml; do
    [ -f "$tpl/$f" ] || die "$tpl/$f is missing. Run: espec update $dir"
  done
  [ "$kind" != bug ] || [ -f "$tpl/bug.md" ] || die "$tpl/bug.md is missing. Run: espec update $dir"
  change="$dir/espec/changes/$name"
  [ ! -e "$change" ] || die "$change already exists"

  today=$(date +%Y-%m-%d)
  mkdir -p "$change/specs"
  for f in feature.md tech-proposal.md tasks.md; do cp "$tpl/$f" "$change/$f"; done
  [ "$kind" != bug ] || cp "$tpl/bug.md" "$change/feature.md"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ticket:*)  [ -z "$ticket" ] || line="ticket: $ticket" ;;
      title:*)   [ -z "$title" ] || line="title: $title" ;;
      kind:*)    [ -z "$kind" ] || line="kind: $kind" ;;
      created:*) line="created: $today" ;;
    esac
    printf '%s\n' "$line"
  done < "$tpl/espec.yaml" > "$change/.espec.yaml"

  echo "Created $change"
  echo "  feature.md  tech-proposal.md  tasks.md  specs/  .espec.yaml"
  echo
  if [ "$kind" = bug ]; then
    echo "Next: fill in feature.md from the bug report (expected versus actual, steps to reproduce),"
    echo "      set status: defined, then run /espec-tech-proposal $name in Copilot Chat"
  else
    echo "Next: in Copilot Chat run  /espec-feature-definition $name"
    echo "      or paste the feature definition from the ticket into feature.md and set status: defined"
  fi
}

cmd_list() {
  local dir="${1:-.}" d name status ticket tasks n=0 archived=0
  need_project "$dir"
  printf '%-36s %-13s %-18s %s\n' NAME STATUS TICKET TASKS
  for d in "$dir"/espec/changes/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    [ "$name" != archive ] || continue
    status=$(yaml_value "$d/.espec.yaml" status)
    ticket=$(yaml_value "$d/.espec.yaml" ticket)
    if [ -f "$d/tasks.md" ]; then tasks=$(task_counts "$d/tasks.md" | awk '{ print $1 "/" $2 }'); else tasks="no tasks"; fi
    printf '%-36s %-13s %-18s %s\n' "$name" "${status:-?}" "${ticket:--}" "$tasks"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || echo "(no active changes)"
  for d in "$dir"/espec/changes/archive/*/; do [ ! -d "$d" ] || archived=$((archived + 1)); done
  echo
  echo "$n active change(s), $archived archived."
}

# ---------------------------------------------------------------- validate

ok()   { CHECKS=$((CHECKS + 1)); echo "  ✔ $*"; }
bad()  { CHECKS=$((CHECKS + 1)); FAILS=$((FAILS + 1)); echo "  ✖ $*"; }
warn() { echo "  ⚠ warning: $*"; }
# expect MESSAGE COMMAND...: records a pass when COMMAND succeeds, a failure otherwise.
expect() { local msg="$1"; shift; if "$@"; then ok "$msg"; else bad "$msg"; fi; }
# fail_each LABEL TEXT: one failure line per line of TEXT.
fail_each() { local l; while IFS= read -r l; do [ -z "$l" ] || bad "$1: $l"; done <<EOF
$2
EOF
}

# section FILE "## Heading": the lines of that section up to the next ## heading.
section() {
  awk -v h="$2" '{ sub(/\r$/, "") } /^## / { t = $0; sub(/[ \t]+$/, "", t); on = (t == h) } on { print }' "$1"
}
section_has_content() {
  section "$1" "$2" | awk 'NR == 1 { next }
    inc { if (/-->/) inc = 0; next }
    /^[ \t]*<!--/ { if (!/-->/) inc = 1; next }
    /[^ \t\r]/ { found = 1 }
    END { exit !found }'
}
marker_ok() { [ "$(head -n 1 "$1" | tr -d '\r')" = "$MARKER" ]; }
forced_ok() { section "$1" "## Forced technical notes" | grep -Fq '⚠'; }
placeholders() { awk '/<[A-Za-z][A-Za-z0-9 -]*>/ && !/^[ \t]*<!--/ { print "line " NR ": " $0 }' "$1"; }
# placeholders_outside_code FILE: as placeholders, but fenced blocks and inline code are skipped.
placeholders_outside_code() {
  awk '/^[ \t]*```/ { fence = !fence; next } fence { next }
       { l = $0; gsub(/`[^`]*`/, "", l) }
       l ~ /<[A-Za-z][A-Za-z0-9 -]*>/ && l !~ /^[ \t]*<!--/ { print "line " NR ": " $0 }' "$1"
}
# feature_ids FILE: UC-n, EC-n and AC-n headings of a feature.md, each once, in order.
feature_ids() { sed -n 's/^### \([UEA]C-[0-9][0-9]*\).*/\1/p' "$1" | awk '!s[$0]++'; }
# forced_ids FILE: FT-n notes of a feature.md, each once.
forced_ids() { sed -n 's/^- \*\*\(FT-[0-9][0-9]*\):\*\*.*/\1/p' "$1" | awk '!s[$0]++'; }
# forced_verdict FT: reads a Forced technical notes review table on stdin and prints what is wrong with
# the row of FT, nothing when its verdict is Accepted, or Overridden with a reason.
forced_verdict() {
  awk -v ft="$1" '
    function trim(s) { gsub(/^[ \t*`]+|[ \t*`]+$/, "", s); return s }
    /^[ \t]*\|/ {
      split($0, c, "|"); if (trim(c[2]) != ft) next
      found = 1; v = trim(c[3]); r = trim(c[4])
      if (v != "Accepted" && v != "Overridden") print "has no Accepted or Overridden verdict"
      else if (v == "Overridden" && (r == "" || r == "-")) print "is Overridden without a reason"
      exit
    }
    END { if (!found) print "has no row" }'
}
# proposal_status FILE: Draft, In review or Approved from the status line, empty when absent.
proposal_status() { grep -oE '\*\*Status:\*\* *(Draft|In review|Approved)' "$1" | head -n 1 | sed 's/.*\*\* *//'; }

validate_feature() {
  local f="$1/feature.md" h id ac left ids
  if [ ! -f "$f" ]; then bad "feature.md missing"; return 0; fi
  expect "feature.md: starts with the marker $MARKER" marker_ok "$f"
  # A bug carries steps to reproduce instead of use cases and edge cases.
  if [ "$(yaml_value "$1/.espec.yaml" kind)" = bug ]; then
    set -- "## Why" "## What" "## Steps to reproduce" "## Out of scope" "## Acceptance criteria"; ids="AC"
  else
    set -- "## Why" "## What" "## Use cases" "## Edge cases" "## Out of scope" "## Acceptance criteria"; ids="UC EC AC"
  fi
  for h in "$@"; do
    if grep -q "^$h[[:space:]]*$" "$f"; then
      expect "feature.md: '$h' present and not empty" section_has_content "$f" "$h"
    else
      bad "feature.md: '$h' missing"
    fi
  done
  for h in $ids; do expect "feature.md: at least one ### $h-n" grep -q "^### $h-[0-9]" "$f"; done
  ac=$(section "$f" "## Acceptance criteria")
  for id in $(sed -n 's/^### \([UE]C-[0-9][0-9]*\).*/\1/p' "$f" | sort -u); do
    printf '%s\n' "$ac" | grep -Eq "(^|[^A-Za-z0-9])$id([^0-9]|$)" \
      || warn "feature.md: $id is not referenced in the Acceptance criteria section"
  done
  if grep -q '^## Forced technical notes' "$f"; then
    expect "feature.md: Forced technical notes carry the ⚠️ marker" forced_ok "$f"
  fi
  left=$(placeholders "$f")
  if [ -z "$left" ]; then ok "feature.md: no template placeholders left"; else fail_each "feature.md: placeholder" "$left"; fi
}

validate_tech_proposal() {
  local c="$1" f="$1/tech-proposal.md" status="" h missing="" st trace review id ft problem n before left
  [ -f "$c/.espec.yaml" ] && status=$(yaml_value "$c/.espec.yaml" status)
  case "$status" in defined|cancelled) echo "  - tech-proposal.md not checked (status $status)"; return 0 ;; esac
  if [ ! -f "$f" ]; then
    case "$status" in
      proposed|in-progress|implemented|archived) bad "tech-proposal.md: missing (required once status is $status)" ;;
      *) echo "  - no tech-proposal.md yet (written by the tech proposal)" ;;
    esac
    return 0
  fi
  if [ "$(yaml_value "$c/.espec.yaml" kind)" = bug ]; then
    set -- "## Context" "## Approach" "## Traceability" "## Test strategy" "## Questions for Product"
  else
    set -- "## Context" "## Approach" "## Architecture" "## APIs and contracts" "## Data model and migrations" \
           "## Technology decisions" "## Traceability" "## Non-functional requirements" "## Rollout and migration" \
           "## Test strategy" "## Risks and trade-offs" "## Questions for Product" "## Open engineering questions"
  fi
  for h in "$@"; do
    grep -q "^$h[[:space:]]*$" "$f" || missing="$missing '$h'"
  done
  if [ -z "$missing" ]; then ok "tech-proposal.md: all sections present"; else bad "tech-proposal.md: missing section(s):$missing"; fi
  st=$(proposal_status "$f")
  case "$st" in
    Draft|"In review"|Approved) ok "tech-proposal.md: status line is '$st'" ;;
    *) bad "tech-proposal.md: status line must be one of Draft, In review, Approved" ;;
  esac
  case "$status" in
    in-progress|implemented|archived)
      if [ "$st" = Approved ]; then ok "tech-proposal.md: Approved before implementation"
      else bad "tech-proposal.md: status line must be Approved once .espec.yaml status is $status"; fi ;;
  esac
  if [ -f "$c/feature.md" ]; then
    trace=$(section "$f" "## Traceability"); n=0; before=$FAILS
    for id in $(feature_ids "$c/feature.md"); do
      n=$((n + 1))
      printf '%s\n' "$trace" | grep -Eq "(^|[^A-Za-z0-9])$id([^0-9]|$)" \
        || bad "tech-proposal.md: $id from feature.md is not in the Traceability table"
    done
    [ "$n" -eq 0 ] || [ "$FAILS" -ne "$before" ] || ok "tech-proposal.md: every UC, EC and AC is in the Traceability table"
    review=$(section "$f" "## Forced technical notes review"); n=0; before=$FAILS
    for ft in $(forced_ids "$c/feature.md"); do
      n=$((n + 1))
      problem=$(printf '%s\n' "$review" | forced_verdict "$ft")
      [ -z "$problem" ] || bad "tech-proposal.md: $ft $problem in Forced technical notes review"
    done
    [ "$n" -eq 0 ] || [ "$FAILS" -ne "$before" ] || ok "tech-proposal.md: every FT-n is Accepted, or Overridden with a reason, in the review"
  fi
  left=$(placeholders_outside_code "$f")
  if [ -z "$left" ]; then ok "tech-proposal.md: no template placeholders left"; else fail_each "tech-proposal.md: placeholder" "$left"; fi
}

# Structural checks shared by delta specs (mode=delta) and main specs (mode=main). Prints one problem per line.
SPEC_AWK='
function flush() {
  if (cur != "") {
    if (needscen && scen == 0) print "requirement has no #### Scenario: " cur
    if (needreason && !reason) print "REMOVED requirement has no **Reason:**: " cur
  }
  cur = ""
}
{ sub(/\r$/, "") }
/<[A-Za-z][A-Za-z0-9 -]*>/ && !/^[ \t]*<!--/ { print "template placeholder left on line " NR ": " $0 }
mode == "main" && /<!-- espec:base / { print "delta base stamp left in a main spec on line " NR " (archive drops it)" }
/^## / {
  flush(); sec = $0; sub(/[ \t]+$/, "", sec)
  if (mode == "delta") {
    if (sec != "## Purpose" && sec != "## ADDED Requirements" && sec != "## MODIFIED Requirements" &&
        sec != "## REMOVED Requirements" && sec != "## RENAMED Requirements")
      print "heading not allowed in a delta spec: " sec
  } else if (sec == "## Purpose") purpose = 1
  else if (sec == "## Requirements") reqs = 1
  else print "heading not allowed in a main spec: " sec
  next
}
/^### Requirement:/ {
  flush(); name = $0; sub(/^### Requirement:[ \t]*/, "", name); sub(/[ \t]+$/, "", name)
  if (name in seen) print "duplicate requirement name: " name
  seen[name] = 1; cur = name; scen = 0; reason = 0
  needscen = (mode == "main" || sec == "## ADDED Requirements" || sec == "## MODIFIED Requirements")
  needreason = (sec == "## REMOVED Requirements")
  next
}
/^### Scenario:/ || /^##### Scenario:/ { print "scenarios need exactly four #: " $0; next }
/^### / { flush(); next }
/^#### Scenario:/ { scen++; next }
/\*\*Reason:\*\*/ { reason = 1 }
END {
  flush()
  if (mode == "main" && !purpose) print "missing ## Purpose"
  if (mode == "main" && !reqs) print "missing ## Requirements"
}'

validate_spec() { # FILE MODE LABEL
  local out
  out=$(awk -v mode="$2" "$SPEC_AWK" "$1")
  if [ -z "$out" ]; then ok "$3: structure ok"; else fail_each "$3" "$out"; fi
}

validate_tasks() {
  local f="$1/tasks.md" badlines
  if [ ! -f "$f" ]; then echo "  - tasks.md not present yet (skipped)"; return 0; fi
  expect "tasks.md: at least one task" grep -Eq '^[[:space:]]*- \[[ xX]\] [A-Za-z0-9]+\.[0-9]+([[:space:]]|$)' "$f"
  badlines=$(awk '/^[ \t]*- \[/ && !/^[ \t]*- \[[ xX]\] [A-Za-z0-9]+\.[0-9]+([ \t\r]|$)/ { print "line " NR ": " $0 }' "$f")
  if [ -z "$badlines" ]; then
    ok "tasks.md: every checkbox is well formed"
  else
    fail_each "tasks.md: use '- [ ] 1.2 ...' or '- [x] 1.2 ...'" "$badlines"
  fi
}

validate_meta() {
  local f="$1/.espec.yaml" status
  if [ ! -f "$f" ]; then bad ".espec.yaml missing"; return 0; fi
  status=$(yaml_value "$f" status)
  case "$status" in
    defined|proposed|in-progress|implemented|archived|cancelled) ok ".espec.yaml: status is '$status'" ;;
    *) bad ".espec.yaml: status '$status' must be one of defined, proposed, in-progress, implemented, archived, cancelled" ;;
  esac
  case "$(yaml_value "$f" kind)" in
    ""|feature|bug) ;;
    *) bad ".espec.yaml: kind '$(yaml_value "$f" kind)' must be feature or bug" ;;
  esac
}

validate_pull_request() {
  local f="$1/pull-request.md" status="" h missing=""
  [ -f "$1/.espec.yaml" ] && status=$(yaml_value "$1/.espec.yaml" status)
  if [ -f "$f" ]; then
    for h in "## Summary" "## Proposal versus implementation" "## Behaviour delivered" "## Deviations and deferred work" "## How to review" "## Verification" "## Rollout" "## Release note"; do
      grep -q "^$h" "$f" || missing="$missing '$h'"
    done
    if [ -z "$missing" ]; then ok "pull-request.md: all sections present"; else bad "pull-request.md: missing section(s):$missing"; fi
  else
    case "$status" in
      implemented|archived) bad "pull-request.md: missing (required once status is $status)" ;;
      *) echo "  - no pull-request.md yet (written at the end of implementation)" ;;
    esac
  fi
}

# ---------------------------------------------------------------- delta bases
# A MODIFIED or REMOVED requirement copies the main spec as it was when the tech proposal was written.
# The delta records that version as a stamp under the heading, <!-- espec:base <hash> -->, so that a
# second change archived first, which edits the same requirement, is caught before its edit is lost.

# hash_stdin: the first 12 hex characters of the SHA-256 of standard input.
hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-12
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-12
  else echo "error: sha256sum or shasum is needed for delta base stamps" >&2; echo nohash; fi
}

# req_block FILE NAME: the requirement block, heading included, normalised: no carriage returns, no
# trailing blanks, no stamp lines, no trailing empty lines. Empty when the requirement is absent.
BLOCK_AWK='
{ sub(/\r$/, ""); sub(/[ \t]+$/, "") }
/^# |^## |^### / { if (on) exit }
/^### Requirement:/ { n = $0; sub(/^### Requirement:[ \t]*/, "", n); if (n == name) on = 1 }
on && !/^[ \t]*<!-- espec:base [0-9a-f]+ -->$/ { buf[++k] = $0; if ($0 != "") last = k }
END { for (i = 1; i <= last; i++) print buf[i] }'
req_block() { [ -f "$1" ] || return 0; awk -v name="$2" "$BLOCK_AWK" "$1"; }
block_hash() { printf '%s\n' "$1" | hash_stdin; }

# delta_entries FILE: "SECTION|NAME|STAMP" per ADDED, MODIFIED or REMOVED requirement of a delta,
# and "RENAMED|FROM|TO" per rename.
DELTA_AWK='
function flush() { if (cur != "" && (sec == "ADDED" || sec == "MODIFIED" || sec == "REMOVED")) print sec "|" cur "|" stamp; cur = "" }
{ sub(/\r$/, ""); sub(/[ \t]+$/, "") }
/^## / { flush(); sec = $0; sub(/^## /, "", sec); sub(/ Requirements$/, "", sec); next }
/^### Requirement:/ { flush(); cur = $0; sub(/^### Requirement:[ \t]*/, "", cur); stamp = ""; next }
/^### / { flush(); next }
cur != "" && /^[ \t]*<!-- espec:base [0-9a-f]+ -->$/ { stamp = $0; sub(/^[ \t]*<!-- espec:base /, "", stamp); sub(/ -->$/, "", stamp) }
sec == "RENAMED" && /^- FROM:/ { from = $0; sub(/^- FROM:[ \t]*`?### Requirement:[ \t]*/, "", from); sub(/[ \t]*`$/, "", from) }
sec == "RENAMED" && /^- TO:/ { to = $0; sub(/^- TO:[ \t]*`?### Requirement:[ \t]*/, "", to); sub(/[ \t]*`$/, "", to); if (from != "") print "RENAMED|" from "|" to; from = "" }
END { flush() }'

# base_target MAIN NAME ENTRIES: the main spec requirement a MODIFIED or REMOVED entry applies to:
# NAME itself, or the FROM of a rename to NAME that the main spec still holds. Empty when neither.
base_target() {
  local from
  if [ -n "$(req_block "$1" "$2")" ]; then echo "$2"; return 0; fi
  from=$(printf '%s\n' "$3" | awk -F'|' -v t="$2" '$1 == "RENAMED" && $3 == t { print $2; exit }')
  if [ -n "$from" ] && [ -n "$(req_block "$1" "$from")" ]; then echo "$from"; fi
}

# validate_delta_base CHANGE SPEC DIR: the delta still applies to the main spec as it is today.
validate_delta_base() {
  local c="$1" spec="$2" dir="$3" cap main label entries sec name stamp target mblock h before
  cap=${spec#$c/specs/}; cap=${cap%/spec.md}
  main="$dir/espec/specs/$cap/spec.md"; label="${spec#$c/}"
  entries=$(awk "$DELTA_AWK" "$spec")
  [ -n "$entries" ] || return 0
  before=$FAILS
  while IFS='|' read -r sec name stamp; do
    [ -n "$sec" ] || continue
    if [ ! -f "$main" ] && [ "$sec" != ADDED ]; then
      bad "$label: $sec '$name' but espec/specs/$cap/spec.md does not exist (conflict)"; continue
    fi
    case "$sec" in
      RENAMED)
        [ -n "$(req_block "$main" "$name")" ] || [ -n "$(req_block "$main" "$stamp")" ] \
          || bad "$label: RENAMED FROM '$name' is not in the main spec (conflict)" ;;
      ADDED)
        mblock=$(req_block "$main" "$name")
        [ -z "$mblock" ] || [ "$mblock" = "$(req_block "$spec" "$name")" ] \
          || bad "$label: ADDED '$name' already exists in the main spec with different content (conflict)" ;;
      MODIFIED|REMOVED)
        target=$(base_target "$main" "$name" "$entries")
        if [ -z "$target" ]; then
          if [ "$sec" = REMOVED ]; then bad "$label: REMOVED '$name' is not in the main spec (conflict, or already removed)"
          else bad "$label: MODIFIED '$name' is not in the main spec (conflict)"; fi
          continue
        fi
        mblock=$(req_block "$main" "$target")
        # Already applied: the main spec holds exactly the delta's text.
        if [ "$sec" = MODIFIED ] && [ "$target" = "$name" ] && [ "$mblock" = "$(req_block "$spec" "$name")" ]; then continue; fi
        h=$(block_hash "$mblock")
        if [ -z "$stamp" ]; then
          bad "$label: $sec '$name' has no base stamp. Run: espec/bin/espec stamp $(basename "$c")"
        elif [ "$stamp" != "$h" ]; then
          bad "$label: $sec '$name' changed in the main spec since the delta was written (base $stamp, now $h). Merge the new text into the delta, then run: espec/bin/espec stamp $(basename "$c") --rebase"
        fi ;;
    esac
  done <<EOF
$entries
EOF
  [ "$FAILS" -ne "$before" ] || ok "$label: applies to the main spec as it is today"
}

cmd_stamp() {
  local name="" dir="." rebase=0 c specs spec cap main label entries sec n stamp target h map mapfile refused=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --rebase) rebase=1; shift ;;
      -*) die "unknown option: $1" ;;
      *) if [ -z "$name" ]; then name="$1"; else dir="$1"; fi; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: espec stamp <change-name> [--rebase] [dir]"
  need_project "$dir"
  c="$dir/espec/changes/$name"
  [ -d "$c" ] || die "change not found: $c"
  mapfile=$(mktemp)
  specs=$([ -d "$c/specs" ] && find "$c/specs" -name spec.md | sort || true)
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    cap=${spec#$c/specs/}; cap=${cap%/spec.md}
    main="$dir/espec/specs/$cap/spec.md"; label="${spec#$c/}"
    entries=$(awk "$DELTA_AWK" "$spec"); map=""
    while IFS='|' read -r sec n stamp; do
      case "$sec" in MODIFIED|REMOVED) ;; *) continue ;; esac
      target=$(base_target "$main" "$n" "$entries")
      if [ -z "$target" ]; then echo "  ✖ $label: $sec '$n' is not in espec/specs/$cap/spec.md"; refused=1; continue; fi
      h=$(block_hash "$(req_block "$main" "$target")")
      if [ "$stamp" = "$h" ]; then echo "  unchanged  $label: $n"
      elif [ -z "$stamp" ]; then echo "  stamped    $label: $n ($h)"
      elif [ "$rebase" -eq 1 ]; then echo "  rebased    $label: $n ($stamp -> $h)"
      else
        echo "  ✖ $label: '$n' changed in the main spec since it was stamped ($stamp, now $h)."
        echo "    Merge the new text into the delta, then run: espec/bin/espec stamp $name --rebase"
        refused=1; continue
      fi
      map="$map$n|$h
"
    done <<EOF
$entries
EOF
    [ -n "$map" ] || continue
    printf '%s' "$map" > "$mapfile"
    # Write each stamp right under its heading and drop any older stamp in the same block.
    awk 'FNR == NR { p = index($0, "|"); if (p) h[substr($0, 1, p - 1)] = substr($0, p + 1); next }
      { t = $0; sub(/\r$/, "", t); sub(/[ \t]+$/, "", t) }
      t ~ /^## / { sec = t; sub(/^## /, "", sec); sub(/ Requirements$/, "", sec); inblk = 0 }
      t ~ /^### / { inblk = 0 }
      inblk && t ~ /^[ \t]*<!-- espec:base [0-9a-f]+ -->$/ { next }
      { print }
      t ~ /^### Requirement:/ && (sec == "MODIFIED" || sec == "REMOVED") {
        n = t; sub(/^### Requirement:[ \t]*/, "", n)
        if (n in h) { print "<!-- espec:base " h[n] " -->"; inblk = 1 }
      }' "$mapfile" "$spec" > "$spec.tmp" && mv "$spec.tmp" "$spec"
  done <<EOF
$specs
EOF
  rm -f "$mapfile"
  [ "$refused" -eq 0 ] || exit 1
}

validate_change() {
  # $2 is the project directory, whose main specs the deltas apply to.
  local c="$1" dir="$2" specs spec
  echo "Change: $(basename "$c")"
  validate_meta "$c"
  validate_pull_request "$c"
  validate_feature "$c"
  validate_tech_proposal "$c"
  specs=$([ -d "$c/specs" ] && find "$c/specs" -name spec.md | sort || true)
  if [ -z "$specs" ]; then
    [ "$(yaml_value "$c/.espec.yaml" skip_specs)" = true ] || echo "  - no delta specs yet (expected after the tech proposal)"
  fi
  while IFS= read -r spec; do [ -z "$spec" ] || validate_spec "$spec" delta "${spec#$c/}"; done <<EOF
$specs
EOF
  if [ "$(yaml_value "$c/.espec.yaml" status)" != cancelled ]; then
    while IFS= read -r spec; do [ -z "$spec" ] || validate_delta_base "$c" "$spec" "$dir"; done <<EOF
$specs
EOF
  fi
  validate_tasks "$c"
}

validate_main_specs() {
  local dir="$1" specs spec
  specs=$([ -d "$dir/espec/specs" ] && find "$dir/espec/specs" -mindepth 2 -name spec.md | sort || true)
  if [ -z "$specs" ]; then echo "Main specs: none yet"; return 0; fi
  echo "Main specs:"
  while IFS= read -r spec; do [ -z "$spec" ] || validate_spec "$spec" main "${spec#$dir/}"; done <<EOF
$specs
EOF
}

cmd_validate() {
  local name="" dir="." c
  if [ $# -ge 2 ]; then name="$1"; dir="$2"
  elif [ $# -eq 1 ]; then if [ -d "$1/espec" ]; then dir="$1"; else name="$1"; fi
  fi
  need_project "$dir"
  if [ -n "$name" ]; then
    [ -d "$dir/espec/changes/$name" ] || die "change not found: $dir/espec/changes/$name"
    validate_change "$dir/espec/changes/$name" "$dir"
  else
    for c in "$dir"/espec/changes/*/; do
      [ -d "$c" ] || continue
      [ "$(basename "$c")" != archive ] || continue
      validate_change "${c%/}" "$dir"
    done
  fi
  validate_main_specs "$dir"
  echo
  echo "$CHECKS checks, $FAILS failures"
  [ "$FAILS" -eq 0 ] || exit 1
}

# ---------------------------------------------------------------- dispatch

cmd="${1:-help}"
[ $# -eq 0 ] || shift
case "$cmd" in
  init)     cmd_init "$@" ;;
  update)   cmd_update "$@" ;;
  new)      cmd_new "$@" ;;
  list)     cmd_list "$@" ;;
  validate) cmd_validate "$@" ;;
  stamp)    cmd_stamp "$@" ;;
  version|--version) cmd_version "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac
